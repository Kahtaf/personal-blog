---
import { SITE, SOCIALS } from "@consts";

interface Props {
  type: "website" | "article";
  title: string;
  description: string;
  url: URL;
  publishDate?: Date;
  author?: string;
  page?: "home" | "about" | "blog" | "projects" | "resume" | "work";
}

const { type, title, description, url, publishDate, page } = Astro.props;

const schemas: Record<string, unknown>[] = [];
const siteURL = Astro.site?.toString();
const pageURL = url.toString();
const personId = `${siteURL}#person`;
const websiteId = `${siteURL}#website`;
const pageId = `${pageURL}#webpage`;
const imageURL = new URL(SITE.IMAGE, Astro.site).toString();

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": personId,
  name: SITE.NAME,
  url: siteURL,
  image: imageURL,
  jobTitle: SITE.JOB_TITLE,
  description: SITE.DESCRIPTION,
  address: {
    "@type": "PostalAddress",
    addressLocality: SITE.LOCATION,
  },
  knowsAbout: SITE.KNOWS_ABOUT,
  sameAs: SOCIALS.map((s) => s.HREF),
};

// WebSite schema on all pages
schemas.push({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  name: SITE.NAME,
  url: siteURL,
  inLanguage: "en",
  publisher: {
    "@id": personId,
  },
});

schemas.push(person);

if (page === "home" || page === "about" || page === "resume") {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": pageId,
    url: pageURL,
    name: title,
    description,
    mainEntity: {
      "@id": personId,
    },
  });
} else if (page === "blog") {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": pageId,
    url: pageURL,
    name: title,
    description,
    publisher: {
      "@id": personId,
    },
  });
} else {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": pageId,
    url: pageURL,
    name: title,
    description,
    isPartOf: {
      "@id": websiteId,
    },
    about: {
      "@id": personId,
    },
  });
}

// Article schema on blog posts
if (type === "article" && publishDate) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description: description,
    datePublished: publishDate.toISOString(),
    image: imageURL,
    author: {
      "@id": personId,
    },
    publisher: {
      "@id": personId,
    },
    mainEntityOfPage: {
      "@id": pageId,
    },
    url: pageURL,
  });

  schemas.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: siteURL,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Blog",
        item: new URL("/blog/", Astro.site).toString(),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: title,
        item: pageURL,
      },
    ],
  });
}
---

{schemas.map((schema) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
