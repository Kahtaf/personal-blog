---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  seoTitle?: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  publishDate?: Date;
  author?: string;
  page?: "home" | "about" | "blog" | "projects" | "resume" | "work";
  noindex?: boolean;
};

const { title, seoTitle = title, description, image, type, publishDate, author, page, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={seoTitle === SITE.NAME ? seoTitle : `${seoTitle} | ${SITE.NAME}`} description={description} image={image} type={type} publishDate={publishDate} author={author} page={page} noindex={noindex} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
