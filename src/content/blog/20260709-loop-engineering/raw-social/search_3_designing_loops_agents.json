    {
      "id": "2063986022401110507",
      "text": "You shouldn't be designing loops to prompt your agents anymore. You should be writing state machines that design loops that prompt your agents.",
      "author": {
        "id": "16375739",
        "name": "kwindla",
        "screenName": "kwindla",
        "profileImageUrl": "https://pbs.twimg.com/profile_images/1790772534914551808/YpwkVUIl_normal.jpg",
        "verified": true
      },
      "metrics": {
        "likes": 49,
        "retweets": 5,
        "replies": 12,
        "quotes": 4,
        "views": 5970,
        "bookmarks": 12
      },
